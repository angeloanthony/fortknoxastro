                <td style="padding: 15px; border: 1px solid #ddd; text-align: center; color: green; font-weight: 700;">$230/mo</td>
                <td style="padding: 15px; border: 1px solid #ddd; text-align: center;">3–4 bedroom home + garage, business inventory</td>
              </tr>
