        <!-- SIDE-BY-SIDE -->
        <h3 style="font-family: 'Montserrat', sans-serif; font-size: 1.15rem; color: var(--primary-dark); margin: 0 0 14px;">All three units, side by side</h3>

        <div style="overflow-x: auto; margin-bottom: 30px;">
          <table style="width: 100%; min-width: 560px; border-collapse: collapse; background: white; box-shadow: var(--shadow-md);">
            <thead>
              <tr style="background: var(--primary-dark); color: white;">
